{
  "name": "irpacific-app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "(prisma db push --skip-generate || echo 'WARNING: database schema update failed - check DATABASE_URL') && next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx scripts/seed.ts",
